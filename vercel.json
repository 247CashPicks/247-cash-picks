{
  "crons": [
    { "path": "/api/cron/scout",                 "schedule": "0 10 * * *"   },
    { "path": "/api/cron/stats",                 "schedule": "0 12 * * *"   },
    { "path": "/api/cron/matchup",               "schedule": "0 13 * * *"   },
    { "path": "/api/cron/defense",               "schedule": "30 13 * * *"  },
    { "path": "/api/cron/projector",             "schedule": "0 14 * * *"   },
    { "path": "/api/cron/lines",                 "schedule": "0 18 * * *"   },
    { "path": "/api/cron/selector",              "schedule": "30 18 * * *"  },
    { "path": "/api/cron/nba-reference-seeder",  "schedule": "0 11 * * 2,5" },
    { "path": "/api/cron/picks-resolver",        "schedule": "0 7 * * *"    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "no-store, max-age=0" }]
    }
  ]
}
